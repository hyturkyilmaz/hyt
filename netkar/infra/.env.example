# NetKâr geliştirme ortamı için örnek değerler. Gerçek sır içermez.
# Kullanım: `make env` bu dosyadan infra/.env üretir ve sırları rastgele doldurur.
# infra/.env asla repoya girmez (.gitignore).

# --- Genel -----------------------------------------------------------------
# Ürün adı tek ayardan okunur (marka adı değişince yalnız burası değişir).
PRODUCT_NAME=NetKâr
# dev | test | prod (prod'da OpenAPI belgesi kapanır)
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=netkar
# Yönetici (superuser) parolası: yalnız Postgres konteyneri kullanır, uygulama kullanmaz.
POSTGRES_PASSWORD=REPLACE_ME_superuser
# Tablo sahibi rol (migrasyon). Parolada URL'de özel anlam taşıyan karakter olmasın (hex önerilir).
NETKAR_OWNER_PASSWORD=REPLACE_ME_owner
# Uygulama rolü (superuser DEĞİL, RLS'ye tabi).
NETKAR_APP_PASSWORD=REPLACE_ME_app

# Yerelde (konteyner dışı) çalışırken kullanılan bağlantılar. Compose içindeki servisler
# bu değerleri kullanmaz; kendi URL'lerini yukarıdaki parolalardan üretir.
DATABASE_URL=postgresql://netkar_app:REPLACE_ME_app@localhost:5432/netkar
DATABASE_MIGRATION_URL=postgresql://netkar_owner:REPLACE_ME_owner@localhost:5432/netkar

# --- Güvenlik --------------------------------------------------------------
# AES-256-GCM ana anahtarı: 32 bayt, base64. Üretmek için: openssl rand -base64 32
# Kaybedilirse şifreli TOTP sırları çözülemez; yedeğini ayrı ve güvenli tutun.
DATA_ENCRYPTION_KEY=REPLACE_ME_base64_32_bytes
# Sızmış parola kontrolü (HIBP, k-anonimlik). Varsayılan kapalı; dış ağ çağrısı yapar.
PWNED_CHECK_ENABLED=false
# İstemci IP'si (rate limit, denetim izi). Varsayılan: hiçbir vekile güvenilmez, X-Forwarded-For
# yok sayılır ve bağlantının eş adresi kullanılır. BFF (Next.js) arkasında web konteynerinin ağını
# yazın (docker network inspect ile bakın); API yalnız bu ağdan erişilebilir olmalıdır.
# Ayrıntı: docs/adr/0002-istemci-ip-ve-vekil-guveni.md
TRUSTED_PROXY_CIDRS=
# Alternatif/ek: sağdan sayılan güvenilir vekil sayısı (eş adres dahil). BFF tek vekil ise 1.
TRUSTED_PROXY_HOPS=0

# --- E-posta (MVP: gerçek servis yok) ----------------------------------------
# file: JSONL dosyasına yazar (geliştirme), memory: yalnız testler için.
EMAIL_BACKEND=file
EMAIL_DEV_OUTBOX_PATH=var/outbox.jsonl
# Sıfırlama bağlantılarında kullanılan web adresi
WEB_BASE_URL=http://localhost:3000

# --- Rate limit (pencere: giriş 15 dk, kayıt ve sıfırlama 1 saat) ------------
RATE_LIMIT_LOGIN_IP=30
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_REGISTER_IP=10
RATE_LIMIT_RESET_IP=10
RATE_LIMIT_RESET_EMAIL=3
RATE_LIMIT_TOTP_USER=10
RATE_LIMIT_TOTP_IP=30
# TOTP kaba kuvvet: bu kadar ardışık hatadan sonra hesap bu süre (sn) TOTP girişine kapanır.
TOTP_MAX_FAILURES=5
TOTP_LOCK_SECONDS=900

# --- İstek gövdesi üst sınırları (bayt) ---------------------------------------
MAX_REQUEST_BODY_BYTES=1048576
MAX_AUTH_BODY_BYTES=65536
