# Sunucu tarafı: /api/v1 isteklerinin yönlendirileceği API adresi (Next.js rewrites).
# Sonunda eğik çizgi olmamalı; "/v1" eklemeyin (rewrites /api/v1/* isteğini API_BASE_URL/v1/* yoluna iletir).
# Derleme sırasında rewrites içine gömülür: değiştirirseniz yeniden derleyin.
API_BASE_URL=http://localhost:8000

# Herkese açık: kanonik site adresi (metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Herkese açık, isteğe bağlı: ürün adını ezer (varsayılan src/config/brand.ts içinde).
# NEXT_PUBLIC_PRODUCT_NAME=NetKâr

# Bekleme listesi kayıt hedefi: memory | file | none. Boşsa geliştirmede bellek, üretimde hedef yok (503).
# WAITLIST_SINK=memory
# WAITLIST_FILE=.data/waitlist.jsonl

# Turnstile (şu an kapalı, anahtar yok). Açmak için src/lib/waitlist/turnstile.ts başındaki notlara bakın.
# TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_ENABLED=false
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
